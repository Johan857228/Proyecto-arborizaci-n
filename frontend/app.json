{
  "expo": {
    "name": "Arbolado Escolar",
    "slug": "arbolado-escolar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "co.edu.upc.arboladoescolar",
      "adaptiveIcon": {
        "backgroundColor": "#0F3D26",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para registrar dónde está el árbol."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Usamos la cámara para documentar el árbol.",
          "photosPermission": "Selecciona fotografías para documentar el árbol.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F3D26",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc52299a-c0cb-4c6c-9e5b-b59a3a6861f5"
      }
    },
    "owner": "inventario-arboreo"
  }
}

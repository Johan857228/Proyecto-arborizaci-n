# proveedor propio o pago.
# EXPO_PUBLIC_MAPA_TESELAS=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# EXPO_PUBLIC_MAPA_ATRIBUCION=© OpenStreetMap

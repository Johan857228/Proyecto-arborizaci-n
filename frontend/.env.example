# Copia este archivo como .env (en la carpeta frontend). No se sube a Git.
# Vite solo expone al código las variables que empiezan por VITE_.
# Se leen con: import.meta.env.VITE_API_URL

# Dirección de la API. En desarrollo apunta al backend local.
# Cuando el frontend se sirva por el proxy HTTPS del backend, usa: VITE_API_URL=/api
VITE_API_URL=http://localhost:8000/api

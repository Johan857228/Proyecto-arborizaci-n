# =============================================================
# Backend - Inventario Arbóreo Escolar
# Copia este archivo como .env (en esta misma carpeta) y completa
# los valores. El archivo .env NO se sube a Git.
# =============================================================

# Entorno: desarrollo | pruebas | produccion
APP_ENV=desarrollo

# Prefijo de todas las rutas de la API (la documentación queda en /api/docs)
API_PREFIX=/api

# --- Base de datos (PostgreSQL) ---
POSTGRES_DB=arborizacion
POSTGRES_USER=arborizacion
# Obligatoria. Escribe una contraseña propia; no la compartas por el chat del equipo.
POSTGRES_PASSWORD=
# Corriendo el backend fuera de Docker: localhost. Docker Compose usa "db" automáticamente.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Opcional. Si tiene valor, reemplaza las cinco variables anteriores.
# Ejemplo para probar sin PostgreSQL: sqlite:///./data/local.db
DATABASE_URL=

# --- Seguridad ---
# Obligatorio en producción (mínimo 32 caracteres). En desarrollo, si se deja vacío,
# se genera uno temporal. Para generar uno:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Direcciones del frontend que pueden llamar a la API, separadas por coma
CORS_ORIGINS=http://localhost:5173

# Primer administrador. Se crea al arrancar solo si la base no tiene usuarios;
# con él se crean los demás desde POST /api/usuarios. Contraseña de 8+ caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Fotografías ---
# Carpeta donde se guardan los archivos. Docker Compose usa un volumen propio.
STORAGE_PATH=data/fotos

# --- Docker Compose: puertos en este computador ---
# Cámbialos si ya están ocupados (por ejemplo, si tienes PostgreSQL instalado).
BACKEND_PORT=8000
DB_PORT=5432

# --- HTTPS (perfiles "https" y "presentacion" de Docker Compose) ---
# localhost      -> certificado local, solo para este computador
# midominio.com  -> certificado real de Let's Encrypt (servidor con puertos 80 y 443 abiertos)
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443
